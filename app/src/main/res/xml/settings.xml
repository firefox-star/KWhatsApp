<?xml version="1.0" encoding="utf-8"?>
<PreferenceScreen
  xmlns:android="http://schemas.android.com/apk/res/android" xmlns:robobunny="http://robobunny.com">
    <PreferenceCategory android:title="KWhatsApp" />
    <kmods.ActionP android:title="Check For Update" android:key="cfu" android:summary="Checking Latest Update" />
    <Preference android:title="Restart Whatsapp" android:key="rest" android:summary="Restart To Apply Changes" />
    <Preference android:title="KWhatsApp v2.6" android:summary="Base v2.17.87" />
    <kmods.ActionP android:title="Changelog" android:key="clogs" android:summary="ChangesLog Of KWhatsApp" />
    <kmods.ActionP android:title="Special Thanks To" android:key="credits" android:summary="Credits" />
    <PreferenceCategory android:title="AI Mods" android:key="cat_ai">
        <SwitchPreference android:title="Enable AI Features" android:key="ai_enabled" android:summary="Master switch for all AI features (smart replies, analysis)" android:defaultValue="false" />
        <SwitchPreference android:title="Auto Suggest Replies" android:key="ai_auto_suggest" android:summary="Analyze incoming messages and show reply suggestions automatically" android:dependency="ai_enabled" android:defaultValue="true" />
        <EditTextPreference android:title="AI API Base URL" android:key="ai_base_url" android:summary="Your own endpoint, e.g. https://api.groq.com/openai/v1" android:dependency="ai_enabled" android:hint="https://your-api.example.com/v1" />
        <EditTextPreference android:title="AI Model Name" android:key="ai_model" android:summary="Model the API should use, e.g. llama-3.1-8b-instant" android:dependency="ai_enabled" android:hint="model-name" />
        <kmods.ai.ApiKeyPreference android:title="API Key / Auth Token" android:key="ai_api_key" android:summary="Paste your API key (stored encrypted)" android:dependency="ai_enabled" />
        <ListPreference android:title="AI Provider Type" android:key="ai_provider" android:entries="@array/ai_provider_names" android:entryValues="@array/ai_provider_values" android:defaultValue="auto" android:summary="How to talk to your endpoint" android:dependency="ai_enabled" />
        <EditTextPreference android:title="AI Instructions (System Prompt)" android:key="ai_system_prompt" android:summary="Optional custom persona/instructions for the reply assistant" android:dependency="ai_enabled" />
        <EditTextPreference android:title="Max Reply Tokens" android:key="ai_max_tokens" android:summary="Upper bound for each completion (default 200)" android:dependency="ai_enabled" />
        <kmods.ActionP android:title="Test AI Connection" android:key="ai_test" android:summary="Verify URL, key and model with one real request" android:dependency="ai_enabled" />
        <SwitchPreference android:title="AI Debug Logging" android:key="ai_debug_log" android:summary="Record AI request/response details for troubleshooting (tag: AiMods)" android:dependency="ai_enabled" android:defaultValue="false" />
        <kmods.ActionP android:title="View AI Debug Logs" android:key="ai_logs" android:summary="Show recent AI activity and errors" android:dependency="ai_enabled" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Globle Whatsapp" android:key="cat_wa">
        <SwitchPreference android:title="@string/HideDate" android:key="hideinfo" android:summary="@string/HideDateSum" android:defaultValue="false" />
        <SwitchPreference android:title="@string/TxtSelect" android:key="txt_select" android:summary="@string/TxtSelectSum" android:defaultValue="false" />
        <SwitchPreference android:title="@string/ArchvChat" android:key="Archv_chats" android:summary="@string/ArchvChatSum" android:defaultValue="false" />
        <SwitchPreference android:title="Auto Update" android:key="Auto_update" android:summary="Auto Update Checking" android:defaultValue="true" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Misc Mods" android:key="cat_misc">
        <SwitchPreference android:title="@string/SmN" android:key="show_my_name_check" android:summary="@string/SmNSum" android:defaultValue="false" />
        <SwitchPreference android:title="@string/SmS" android:key="show_my_status_check" android:summary="@string/SmSSum" android:dependency="show_my_name_check" android:defaultValue="false" />
        <SwitchPreference android:title="@string/MultiChat" android:key="Multi_chats" android:summary="@string/MultiChatSum" android:defaultValue="false" />
        <SwitchPreference android:title="Auto Restart" android:key="Auto_restart" android:summary="Auto Restart On Back Press" android:defaultValue="true" />
        <kmods.ActionP android:title="Clear Emojis" android:key="clemoji" android:summary="Clear Your Recent Emojis." />
        <kmods.ActionP android:title="Clear Logs" android:key="cllogs" android:summary="Clear Old Junk Logs." />
        <Preference android:title="Create Shortcut" android:key="cshort" android:summary="@string/ShortcutSum" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Special Mods" android:key="cat_extra">
        <SwitchPreference android:title="@string/coToast" android:key="contact_online_toast" android:summary="@string/coToastSum" android:defaultValue="false" />
        <SwitchPreference android:title="@string/gCounter" android:key="gCounter_check" android:summary="@string/gCounterSum" android:defaultValue="false" />
        <ListPreference android:entries="@array/bubble_n" android:title="@string/B" android:key="bubble_s" android:summary="@string/SB" android:defaultValue="stock" android:entryValues="@array/bubble_v" />
        <ListPreference android:entries="@array/tick_n" android:title="@string/T" android:key="tick_s" android:summary="@string/ST" android:defaultValue="stock" android:entryValues="@array/tick_v" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Hidden Mods" android:key="cat_extra">
        <SwitchPreference android:title="Edit" android:key="edit" android:summary="Enable Unsend Message Option" android:defaultValue="true" />
        <SwitchPreference android:title="New Entry" android:key="video_call_input_box" android:summary="Enable new Entry Style" android:defaultValue="true" />
        <SwitchPreference android:title="Old Status" android:key="old_status" android:summary="Enable Old Status" android:defaultValue="true" />
        <SwitchPreference android:title="Gif Search Provider" android:key="gif_s_provider" android:summary="Choose Gif Search Provider(Enable=GIPHY and Disable=Tenor)" android:defaultValue="false" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Media Mods" android:key="cat_misc">
        <SwitchPreference android:title="@string/UpSizeLimit" android:key="up_size" android:summary="@string/UpSizeLimitSum" android:defaultValue="false" />
        <kmods.BadlatiPrefs android:max="10240" android:title="Maximum Image Size" android:key="image_max_kbytes" android:defaultValue="5120" robobunny:min="0" robobunny:unitsLeft="" robobunny:unitsRight="KB" />
        <kmods.BadlatiPrefs android:max="100" android:title="JPG Image Quality" android:key="image_quality" android:defaultValue="80" robobunny:min="0" robobunny:unitsLeft="" robobunny:unitsRight="%" />
        <kmods.BadlatiPrefs android:max="5315" android:title="Maximum Image Resolution" android:key="image_max_edge" android:defaultValue="1280" robobunny:min="0" robobunny:unitsLeft="" robobunny:unitsRight="PX" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Status Mods" android:key="cat_statis">
        <kmods.BadlatiPrefs android:max="100" android:title="Status image quality" android:key="status_image_quality" android:defaultValue="50" robobunny:min="50" robobunny:unitsLeft="" robobunny:unitsRight="%" />
        <kmods.BadlatiPrefs android:max="10240" android:title="Maximum status image size" android:key="status_image_max_edge" android:defaultValue="1024" robobunny:min="1024" robobunny:unitsLeft="" robobunny:unitsRight=" KB" />
        <kmods.BadlatiPrefs android:max="900" android:title="Status video maximum duration" android:key="status_video_max_duration" android:defaultValue="45" robobunny:min="45" robobunny:unitsLeft="" robobunny:unitsRight=" Seconds" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Backup And Restore" android:key="cat_br">
        <kmods.ActionP android:title="Backup" android:key="backup" android:summary="@string/BackupSum" />
        <kmods.ActionP android:title="Restore" android:key="restore" android:summary="@string/RestoreSum" />
    </PreferenceCategory>
    <PreferenceCategory android:title="Share And Report" android:key="cat_sr">
        <kmods.ActionP android:title="@string/Share" android:key="share" android:summary="@string/ShareSum" />
        <kmods.ActionP android:title="@string/report" android:key="report" android:summary="@string/reportSum" />
    </PreferenceCategory>
</PreferenceScreen>